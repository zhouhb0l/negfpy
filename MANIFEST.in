include _negfpy_build.py
include README.md
include CHANGELOG.md
include PROJECT_NOTES.md
include SOURCE_PROVENANCE.json
include requirements-tested.txt
recursive-include src/negfpp *.py
recursive-include docs *.md
recursive-include examples *.md *.json *.yaml *.yml *.hdf5 *.h5 *.npy *.npz *.csv
recursive-include examples *SHA256SUMS
exclude AGENTS.md
prune generated
prune .local
global-exclude __pycache__ *.py[cod]
